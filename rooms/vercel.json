{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["fra1"],
  "outputDirectory": "public",
  "functions": {"api/room.mjs": {"maxDuration": 15}},
  "rewrites": [{"source": "/room", "destination": "/api/room"}],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"}
    ]}
  ]
}
